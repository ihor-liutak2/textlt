#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
docker=${TEXTLT_DOCKER:-docker}
export TEXTLT_VERSION=$("$repo_root/scripts/textlt-docker-version.sh")
project_directory=$repo_root
compose_file=$repo_root/compose.yaml
if [[ "${docker##*/}" == docker.exe ]]; then
    project_directory=$(wslpath -w "$project_directory")
    compose_file=$(wslpath -w "$compose_file")
    export WSLENV="${WSLENV:+$WSLENV:}TEXTLT_VERSION"
fi

exec "$docker" compose \
    --project-directory "$project_directory" \
    -f "$compose_file" \
    "$@"
