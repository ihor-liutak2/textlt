# Exercise the real CLI with a new profile, including paths containing spaces.
string(RANDOM LENGTH 16 id)
set(profile "${CMAKE_CURRENT_BINARY_DIR}/startup check ${id}")
file(MAKE_DIRECTORY "${profile}")
foreach(variable HOME USERPROFILE APPDATA LOCALAPPDATA XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME)
  set(ENV{${variable}} "${profile}/${variable}")
endforeach()
set(ENV{TEXTLT_DATA_DIR} "${resources}")

function(run_check should_pass expected)
  execute_process(COMMAND "${exe}" --startup-check WORKING_DIRECTORY "${profile}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE stderr TIMEOUT 60)
  message("${output}${stderr}")
  if(should_pass)
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "Fresh profile failed with ${status}")
    endif()
  elseif(NOT status STREQUAL "1")
    message(FATAL_ERROR "Expected a diagnostic failure, got ${status}")
  endif()
  string(FIND "${output}" "${expected}" match)
  if(match EQUAL -1)
    message(FATAL_ERROR "Missing diagnostic: ${expected}")
  endif()
endfunction()

run_check(TRUE "TextLT startup check passed.")
if(WIN32)
  set(config "$ENV{APPDATA}/textlt/config.json")
  file(READ "${config}" original)
  execute_process(COMMAND attrib +R "${config}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not mark the existing config read-only")
  endif()
  run_check(FALSE "[FAIL] Read/write existing")
  execute_process(COMMAND attrib -R "${config}")
  file(READ "${config}" after)
  if(NOT after STREQUAL original)
    message(FATAL_ERROR "Diagnostics changed the protected configuration")
  endif()
  # WD on a directory denies creation of files. Existing files remain readable.
  set(themes "$ENV{APPDATA}/textlt/themes")
  execute_process(COMMAND icacls "${themes}" /deny "*S-1-1-0:(WD)" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not apply the disposable profile ACL")
  endif()
  run_check(FALSE "[FAIL] Write, read, rename and delete")
  execute_process(COMMAND icacls "${themes}" /remove:d "*S-1-1-0" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Could not remove the disposable profile ACL")
  endif()
else()
  execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT uid STREQUAL "0")
    set(config "$ENV{HOME}/.config/textlt/config.json")
    file(READ "${config}" original)
    execute_process(COMMAND chmod a-w "${config}")
    run_check(FALSE "[FAIL] Read/write existing")
    execute_process(COMMAND chmod u+w "${config}")
    file(READ "${config}" after)
    if(NOT after STREQUAL original)
      message(FATAL_ERROR "Diagnostics changed the protected configuration")
    endif()
  endif()
  set(saved_path "$ENV{PATH}")
  set(ENV{PATH} "${profile}/empty-path")
  run_check(FALSE "[FAIL] curl")
  set(ENV{PATH} "${saved_path}")
endif()

# Block directory creation even for an elevated CI account.
file(WRITE "${profile}/blocked" "preserve")
set(ENV{APPDATA} "${profile}/blocked")
set(ENV{XDG_CONFIG_HOME} "${profile}/blocked")
run_check(FALSE "[FAIL] Write, read, rename and delete")
file(READ "${profile}/blocked" after)
if(NOT after STREQUAL "preserve")
  message(FATAL_ERROR "Diagnostics changed the blocking file")
endif()
file(REMOVE_RECURSE "${profile}")
